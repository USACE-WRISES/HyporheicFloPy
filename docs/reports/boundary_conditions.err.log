nlay)                               # Number of layers

gw_elevation_right = interpolate_gw_elevation(
    right_boundary_cells_first_layer,   # List of (y, x) for right boundary cells in the first layer
    right_boundary_cells,               # List of (y, x) for right boundary cells
    gw_elevation_right_first,           # First elevation for interpolation
    gw_elevation_right_last,            # Last elevation for interpolation
    nlay)                               # Number of layers

gw_elevation_upstream = interpolate_gw_elevation_with_river(
    upstream_boundary_cells_first_layer,  # List of (y, x) for upstream boundary cells in the first layer
    gw_elevation_upstream_first,          # First elevation for interpolation
    gw_elevation_upstream_last,           # Last elevation for interpolation
