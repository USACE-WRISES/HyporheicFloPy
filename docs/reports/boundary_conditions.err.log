#---------------------- Calculate Graoundwater Elevation ------------------------#
## Interpolate Groundwater Elevation Across Boundary Cells
def interpolate_gw_elevation(boundary_cells_first_layer, gw_elevation_first, gw_elevation_last, nlay):
    
    n = len(boundary_cells_first_layer)
    if n <= 1:
        # If there's only one cell, apply the same value to all layers
        interpolated_gw_elevations_first_layer = [gw_elevation_first] * n
    else:
        # Interpolate values across the first layer
        interpolated_gw_elevations_first_layer = [
            gw_elevation_first + (gw_elevation_last - gw_elevation_first) * i / (n - 1)
            for i in range(n)
        ]

    # Replicate the interpolated values for the first layer across all layers
    gw_elevations_all_layers = []
    for _ in range(nlay):
        gw_elevations_all_layers.extend(interpolated_gw_elevations_first_layer)

    return gw_elevations_all_layers

## Function to find intersections and interpolate groundwater elevations
def interpolate_gw_elevation_with_river(boundary_cells_first_layer, gw_elevation_first, gw_elevation_last, nlay, river_cells):
    
    # Extract river cell coordinates and elevations
    river_cell_dict = {(y, x): river_height for k, y, x, river_height in river_cells}

    # Interpolate values across the first layer
    n = len(boundary_cells_first_layer)
    if n <= 1:
        interpolated_gw_elevations_first_layer = [gw_elevation_first] * n
    else:
        interpolated_gw_elevations_first_layer = [
            gw_elevation_first + (gw_elevation_last - gw_elevation_first) * i / (n - 1)
            for i in range(n)
        ]

    # Replace interpolated values with river elevations where they intersect
    for i, (y, x) in enumerate(boundary_cells_first_layer):
        if (y, x) in river_cell_dict:
            interpolated_gw_elevations_first_layer[i] = river_cell_dict[(y, x)]

    # Replicate the interpolated values for the first layer across all layers
    gw_elevations_all_layers = []
    for _ in range(nlay):
        gw_elevations_all_layers.extend(interpolated_gw_elevations_first_layer)

    return gw_elevations_all_layers

## Interpolate groundwater elevations for each boundary
gw_elevation_left = interpolate_gw_elevation(
left_boundary_cells_first_layer,    # List of (y, x) for left boundary cells in the first layer
left_boundary_cells,                # List of (y, x) for left boundary cells
gw_elevation_left_first,            # First elevation for interpolation
